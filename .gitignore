# ---------------------------------------------------------------------------
# Project YK — .gitignore
# Keeps sensitive business data, runtime artefacts, and local state out of git.
# ---------------------------------------------------------------------------

# Database / runtime data
*.db
*.db-journal
*.db-wal
*.db-shm

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtualenvs
venv/
.venv/
env/
ENV/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# OS
desktop.ini

# Logs
*.log
logs/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
# Google service-account keys (Sheets API etc.) — NEVER commit
*-*.iam.gserviceaccount.com.json
noble-history-*.json
*service-account*.json
*service_account*.json
ProjectYK_System/app/data/email_google_refresh.token

# Sensitive business data (payroll/accounting files — NEVER commit)
data/
ProjectYK_System/*.xlsx
ProjectYK_System/*.xls
ProjectYK_System/*.xlsm
ProjectYK_System/Daily.xlsx
ProjectYK_System/*.csv
audit_*.csv
fuel_*.csv
*.pdf
*payroll*.xlsx
*เงินเดือน*

# AccidentCases raw photos / large binary inputs
AccidentCases/uploads/
AccidentCases/*.jpg
AccidentCases/*.png

# Nested git repos (deployable subfolders — keep separate)
transport-rate-calculator-repo/

# Backups
*.bak
*.bak_*
*.backup
*.backup_*
*.db.backup*
*.db.bak_*
app.db
app.db-wal
app.db-shm
backup_*/

# BitLocker / recovery keys (NEVER commit — full-disk unlock secret)
*RecoveryKey*
BitLocker*.txt

# Docs scratch
.cursor/history/
.cursor/sessions/
.cursor/projects/

# Temporary inspection/scratch files
_tmp*
_tmp_*.txt

# Generated/scratch JSON data (re-creatable from source — not source of truth)
plan_parse.json
ProjectYK_System/app/missing_fee_may.json
ProjectYK_System/reports/pump_credit_latest.json
ProjectYK_System/reports/gps_inbox/
ProjectYK_System/reports/pump_inbox/

# Temporary commit messages
.git/COMMIT_MSG*.txt

# Python build artefacts
build/
dist/
*.egg-info/

# git worktrees
.worktrees/

# Personal tooling / scratch (NOT Project YK source — local to dev machine)
Claude Usage/
_Claude Tools/
_SETUP/
assets/
Delete/
run_claude_9arm.bat
node_modules/

# Generated reports (re-creatable from builders)
ProjectYK_System/reports/*.xlsx

# LCB petty proof — raw bank slips (contain account numbers, do not commit)
reports/lcb_slips_*/
# slip-reader dry-run output (contains recipient account names)
reports/slip_reader_dryrun*.md

# slip-reader local test data (archive copy + slip images — bank account data)
ProjectYK_System/slip_reader/_devdata/

# Superpowers brainstorm scratch (mockups, transient)
.superpowers/

# net_guard / snapshot ชั่วคราว (ผลรัน ไม่ใช่โค้ด)
ProjectYK_System/reports/_net_guard.json
ProjectYK_System/reports/_bigc_guard.json

# Chrome PDF work dir (สลิป ZIP per-driver) — ชั่วคราว ลบทุกครั้งหลังสร้าง
ProjectYK_System/app/_pdf_tmp/

# done-alarm runtime state
ProjectYK_System/tools/done-alarm/enabled.flag
ProjectYK_System/tools/_kb_payout_cache/
# Oatside runtime outputs (ใน app — สร้างใหม่ได้เสมอ)
ProjectYK_System/app/oatside/uploads/
ProjectYK_System/app/oatside/TransportRateCalculator/
ProjectYK_System/app/oatside/Oatside_PG_Trip_Summary_By_Site.xlsx
ProjectYK_System/app/oatside/_last_build.json
ProjectYK_System/app/oatside/*.bak-*
gdrive_token.json
ProjectYK_System/app/uploads/

