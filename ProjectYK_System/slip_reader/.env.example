# Slip-reader secrets — copy to .env on the server and fill in real values.
# .env is gitignored; this .example file is safe to commit (no secrets).

# Anthropic API key (sk-ant-...). Money — keep out of git/chat. (RUNBOOK §0)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Shared service token — MUST be the exact same string set in start_mvp.bat
# (set YK_SLIP_INGEST_TOKEN=...). Endpoint returns 401 if it doesn't match.
YK_SLIP_INGEST_TOKEN=REPLACE_ME_same_as_start_mvp_bat

# MVP ingest endpoint (slip-reader runs on the same box as the MVP).
MVP_INGEST_URL=http://127.0.0.1:8010/api/petty/ingest

# Model: Sonnet reads Thai driver names far better than Haiku (drives who gets paid).
SLIP_CLAUDE_MODEL=claude-sonnet-4-6
